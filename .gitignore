__pycache__/
*.pyc
.venv/
.coverage

.serena/

node_modules/

# Workflow-generated artifacts (created at repo root during CI runs)
pre_assembled_static.txt
.events/
.transcripts/
validation/*
# Track canonical validation test templates despite the broad ignore above
!validation/tests/
validation/tests/*
!validation/tests/*.sh
validation/
# Review pipeline runtime artifacts. Ledger is per-PR (pr-<N>.txt) and
# persisted across autofix iterations via actions/cache in
# review_autofix.yml — never committed to the branch.
.ai/review_issue_ledger/
.ai/review_runtime/
.ai/workflow_traces/
# Workspace-reuse manifest generated by scripts/workspace_init.sh.
.ai/.workspace_source_manifest.txt
# Kept for backward compat with older consumers that still write the
# legacy single-file path.
.ai/review_issue_ledger.txt

# Workflow-fetched support-source checkouts (runtime-only, never committed)
.codex-workflow-src/
.codex-workflow-src-main/
prompts/.*.identity.*
prompts/.*.assembled.*

.tasks/
.worktrees/
