{% set requirements_file = slots.get("requirements_file", "requirements.txt") -%}
{% set runtime_http_tests_enabled = selection.get("runtime_http_tests_enabled", true) if selection is defined else true -%}
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN apt-get update \
	&& apt-get install -y --no-install-recommends curl jq \
	&& rm -rf /var/lib/apt/lists/*

COPY . /workspace

RUN if [ -f "{{ requirements_file }}" ]; then \
		pip install --no-cache-dir -r "{{ requirements_file }}"; \
	fi \
	&& pip install --no-cache-dir flask jinja2 jsonschema pyyaml pymongo pytest

{% if runtime_http_tests_enabled %}
ENV FLASK_APP="{{ manifest.get('entry', 'app.py') }}" \
	FLASK_RUN_HOST="0.0.0.0" \
	FLASK_RUN_PORT="{{ manifest.get('port', 8000) }}"

CMD ["/bin/sh", "-c", "echo $$ > /tmp/flask-app.pid; exec python -m flask --app \"${FLASK_APP}\" run --host=\"${FLASK_RUN_HOST}\" --port=\"${FLASK_RUN_PORT}\""]
{% else %}
CMD ["/bin/sh", "-c", "trap 'exit 0' TERM INT; while :; do sleep 5; done"]
{% endif %}
