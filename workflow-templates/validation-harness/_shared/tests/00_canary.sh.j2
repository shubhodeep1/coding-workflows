#!/usr/bin/env bash
set -euo pipefail

CANARY_TOOLS=(
{% for tool in slots.canary_tools %}
	'{{ tool | replace("'", "'\"'\"'") }}'
{% endfor %}
)
for tool in "${CANARY_TOOLS[@]}"; do
	if ! command -v "${tool}" >/dev/null 2>&1; then
		echo "missing required canary tool: ${tool}" >&2
		exit 1
	fi
	echo "ok canary tool: ${tool}"
done
