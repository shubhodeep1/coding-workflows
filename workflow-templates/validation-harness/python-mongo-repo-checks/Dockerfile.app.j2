{% set requirements_file = slots.get("requirements_file", "requirements.txt") -%}
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN apt-get update \
	&& apt-get install -y --no-install-recommends bash curl jq \
	&& rm -rf /var/lib/apt/lists/* \
	&& python3 -m pip install --no-cache-dir --disable-pip-version-check \
		pyyaml \
		jsonschema \
		jinja2 \
		pytest

COPY . /workspace

RUN if [ -f "{{ requirements_file }}" ]; then \
		python3 -m pip install --no-cache-dir --disable-pip-version-check -r "{{ requirements_file }}"; \
	fi

CMD ["sh", "-c", "while :; do sleep 3600; done"]
