#!/usr/bin/env bash
set -euo pipefail

CANARY_TOOLS="${CANARY_TOOLS:-curl jq node npx forge cast}"
read -r -a TOOL_LIST <<< "${CANARY_TOOLS}"

tool_count=0
for _tool in "${TOOL_LIST[@]}"; do
	tool_count=$((tool_count + 1))
done

echo "1..${tool_count}"

test_id=1
for tool in "${TOOL_LIST[@]}"; do
	if ! command -v "${tool}" >/dev/null 2>&1; then
		echo "not ok ${test_id} - canary tool available: ${tool}"
		echo "# missing required canary tool: ${tool}"
		exit 1
	fi
	echo "ok ${test_id} - canary tool available: ${tool}"
	test_id=$((test_id + 1))
done
