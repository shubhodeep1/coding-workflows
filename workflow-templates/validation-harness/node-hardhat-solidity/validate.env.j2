{%- set env_overrides = manifest.get('env_overrides', {}) or {} -%}
APP_SERVICE="app"
APP_URL=""
# ANVIL_PORT is the chain RPC port (anvil --port); `manifest.port` is the app
# HTTP listener and a different concept, so do not derive ANVIL_PORT from it.
# Override via `env_overrides.ANVIL_PORT` if a non-default chain port is needed.
ANVIL_PORT="8545"
RPC_URL=""
CANARY_TOOLS="{{ slots.canary_tools | join(' ') }}"
HEALTH_TIMEOUT_SECONDS="120"
HEALTH_POLL_INTERVAL_SECONDS="2"
TAIL_LINES="60"
VALIDATION_TEST_USERNAME="validation-user"
VALIDATION_TEST_PASSWORD="validation-password"
VALIDATION_TEST_API_KEY="validation-api-key"
{%- for key, value in env_overrides | dictsort %}
{{ key }}="{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') | replace('\r', '\\r') | replace('\n', '\\n') }}"
{%- endfor %}
