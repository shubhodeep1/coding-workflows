services:
  app:
    init: true
    build:
      context: ..
      dockerfile: {{ output_root_name }}/Dockerfile.app
    working_dir: /workspace
    command: ["/bin/sh", "-c", "sleep infinity"]
    healthcheck:
      test:
        - "CMD-SHELL"
{%- if manifest.get('entry', 'scripts/run_validation_repo_checks.sh').split() | length > 1 %}
        - "test -d /workspace"
{%- else %}
        - "test -d /workspace && ( test -f \"/workspace/{{ manifest.get('entry', 'scripts/run_validation_repo_checks.sh') | replace('"', '\\"') | replace('$', '$$') }}\" || command -v \"{{ manifest.get('entry', 'scripts/run_validation_repo_checks.sh') | replace('"', '\\"') | replace('$', '$$') }}\" >/dev/null 2>&1 )"
{%- endif %}
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 3s
