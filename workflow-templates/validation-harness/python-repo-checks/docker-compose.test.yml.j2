services:
  app:
    init: true
    build:
      context: ..
      dockerfile: {{ output_root_name }}/Dockerfile.app
    working_dir: /workspace
    command: ["/bin/sh", "-c", "sleep infinity"]
    healthcheck:
      test:
        - "CMD-SHELL"
        - "entry=\"{{ manifest.get('entry', 'scripts/run_validation_repo_checks.sh') | replace('"', '\\"') | replace('$', '$$') }}\"; for entry_tok in $$entry; do if [ -f \"/workspace/$$entry_tok\" ]; then exit 0; fi; done; exit 1"
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 3s
