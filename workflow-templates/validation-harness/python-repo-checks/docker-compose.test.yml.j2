{%- set _repo_check_entry = manifest.get('entry', 'scripts/run_validation_repo_checks.sh') | trim -%}
services:
  app:
    init: true
    build:
      context: ..
      dockerfile: {{ output_root_name }}/Dockerfile.app
    working_dir: /workspace
    command: ["/bin/sh", "-c", "sleep infinity"]
    healthcheck:
      test:
        - "CMD-SHELL"
{%- if _repo_check_entry.split() | length > 1 %}
        - "test -d /workspace"
{%- else %}
        - "test -d /workspace && ( test -f \"/workspace/{{ _repo_check_entry | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') | replace('\r', '\\r') | replace('\n', '\\n') }}\" || command -v \"{{ _repo_check_entry | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') | replace('\r', '\\r') | replace('\n', '\\n') }}\" >/dev/null 2>&1 )"
{%- endif %}
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 3s
