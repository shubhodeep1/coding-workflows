{%- set _repo_check_entry = manifest.get('entry', 'scripts/run_validation_repo_checks.sh') | trim -%}
{%- set _repo_check_entry_shell = _repo_check_entry | replace("'", "'\"'\"'") | replace('$', '$$') | replace('\r', '\\r') | replace('\n', '\\n') -%}
{%- set _repo_check_healthcheck -%}
test -d /workspace && ( _repo_check_health_entry='{{ _repo_check_entry_shell }}'; _repo_check_health_command=; _repo_check_health_path_seen=0; for _repo_check_health_token in $$_repo_check_health_entry; do _repo_check_health_token=$${_repo_check_health_token#\"}; _repo_check_health_token=$${_repo_check_health_token%\"}; _repo_check_health_token=$${_repo_check_health_token#\'}; _repo_check_health_token=$${_repo_check_health_token%\'}; case "$$_repo_check_health_token" in *=*) _repo_check_health_assignment_name=$${_repo_check_health_token%%=*}; case "$$_repo_check_health_assignment_name" in ""|[!A-Za-z_]*|*[!A-Za-z0-9_]*) ;; *) continue ;; esac ;; esac; [ -n "$$_repo_check_health_command" ] || _repo_check_health_command=$$_repo_check_health_token; if [ -f "/workspace/$$_repo_check_health_token" ] || [ -d "/workspace/$$_repo_check_health_token" ]; then exit 0; fi; case "$$_repo_check_health_token" in */*|*\\*) _repo_check_health_path_seen=1 ;; esac; done; [ "$$_repo_check_health_path_seen" -eq 0 ] && [ -n "$$_repo_check_health_command" ] && command -v "$$_repo_check_health_command" >/dev/null 2>&1 )
{%- endset -%}
services:
  app:
    init: true
    build:
      context: ..
      dockerfile: {{ output_root_name }}/Dockerfile.app
    working_dir: /workspace
    command: ["/bin/sh", "-c", "sleep infinity"]
    healthcheck:
      test:
        - "CMD-SHELL"
        - {{ _repo_check_healthcheck | tojson }}
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 3s
