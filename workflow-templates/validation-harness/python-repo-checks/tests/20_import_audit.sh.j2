#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/../_lib/tap_helpers.sh"

_default_compose_file={{ (output_root_name ~ '/docker-compose.test.yml') | shell_quote }}
COMPOSE_FILE="${COMPOSE_FILE:-${_default_compose_file}}"
APP_SERVICE="${APP_SERVICE:-app}"
_default_container_import_audit={{ ('/workspace/' ~ output_root_name ~ '/tests/_lib/import_audit.py') | shell_quote }}
CONTAINER_IMPORT_AUDIT="${CONTAINER_IMPORT_AUDIT:-${_default_container_import_audit}}"

echo "1..1"

set +e
audit_output="$(docker compose -f "${COMPOSE_FILE}" exec -T "${APP_SERVICE}" python3 "${CONTAINER_IMPORT_AUDIT}" 2>&1)"
audit_rc=$?
set -e

if [ "${audit_rc}" -ne 0 ]; then
	tap_not_ok 1 "import audit subprocess isolation"
	if [ -n "${audit_output}" ]; then
		printf '%s\n' "${audit_output}" | sed 's/^/# /'
	fi
	echo "# import audit failed inside app container"
	exit 1
fi

tap_ok 1 "import audit subprocess isolation"
