      "Bash(gh workflow run ai-security-audit.yml *)",
      "Bash(gh workflow run internal-validate.yml *)",
      "Bash(gh workflow run ai-validate.yml *)",
      "Bash(gh workflow run review_autofix.yml *)",
      "Bash(gh workflow run ai-review.yml *)",
      "Bash(python3 -m pytest *)",
      "Bash(PYTHONDONTWRITEBYTECODE=1 python3 -m pytest *)",
      "Bash(PYTHONDONTWRITEBYTECODE=1 python3 scripts/lint_pr_body_auto_close.py *)",
      "Bash(ruff check *)",
      "Bash(yamllint *)",
      "Bash(test *)",
      "Bash(python3 .claude/scripts/check_in_status.py *)",
      "Bash(PYTHONDONTWRITEBYTECODE=1 python3 .claude/scripts/check_in_status.py *)",
      "Bash(python3 scripts/claude_issue_route.py queue-pending *)",
      "Bash(PYTHONDONTWRITEBYTECODE=1 python3 scripts/claude_issue_route.py queue-pending *)",
      "mcp__github__create_pull_request",
