{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-workflows.example/schemas/slot_manifest.schema.json",
  "title": "Validation Harness Slot Manifest",
  "type": "object",
  "required": [
    "type",
    "slots"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string"
    },
    "port": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
        }
      ]
    },
    "health_check": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "custom_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skip_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slots": {
      "type": "object",
      "required": [
        "project_name",
        "canary_tools"
      ],
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "canary_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "tap_plan": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
