{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/run_ledger_entry.v1.json",
  "title": "RunLedgerEntryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "schema_version",
    "run_id",
    "workflow",
    "issue_number",
    "pr_number",
    "event_type",
    "status",
    "message",
    "actor",
    "metadata",
    "timestamp"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "schema_version": {
      "type": "string",
      "const": "run_ledger_entry.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "issue_number": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "pr_number": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Open-set event type. New values are added additively without a schema version bump."
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "metadata": {
      "type": "object",
      "description": "Open metadata bag for additive per-event fields.",
      "properties": {
        "run_substate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "attempt": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "lane": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "tokens": {
          "type": "object",
          "description": "Open token-count bag for additive usage fields.",
          "properties": {
            "input": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "output": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "total": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
