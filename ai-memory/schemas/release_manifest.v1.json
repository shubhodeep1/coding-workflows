{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/release_manifest.v1.json",
  "title": "ReleaseManifestV1",
  "description": "Files the consumer updater (.github/workflows/update_workflows.yml) may copy from a coding-workflows release, built by scripts/release_manifest.py.",
  "$comment": "Path uniqueness and C byte-order sorting of files[] are enforced by the builder; JSON Schema cannot express them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "release_sha",
    "tag",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "release_manifest.v1"
    },
    "repository": {
      "type": "string",
      "const": "shubhodeep1/coding-workflows"
    },
    "release_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "size",
              "mode"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "type": "string",
                "enum": [
                  "100644",
                  "100755"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "size",
              "mode",
              "link_target"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "type": "string",
                "const": "120000"
              },
              "link_target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
