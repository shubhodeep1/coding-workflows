{
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": [
			"node",
			"mocha"
		],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0",
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": [
		"hardhat.config.ts",
		"test/**/*.ts"
	]
}
