{
  "schema_version": "write_guards.v1",
  "phases": {
    "implement": {
      "allowed_globs": [
        "**"
      ],
      "blocked_globs": [
        ".git/**"
      ],
      "conditional_blocked_globs": [
        {
          "env_var": "ALLOW_WORKFLOW_EDITS",
          "allowed_values": [
            "true"
          ],
          "globs": [
            ".github/workflows/**"
          ]
        }
      ]
    },
    "review_editor": {
      "allowed_globs": [
        "**"
      ],
      "blocked_globs": [
        ".git/**"
      ],
      "conditional_blocked_globs": [
        {
          "env_var": "ALLOW_WORKFLOW_EDITS",
          "allowed_values": [
            "true"
          ],
          "globs": [
            ".github/workflows/**"
          ]
        }
      ]
    },
    "validate_fix_harness": {
      "allowed_globs": [
        "validation/**",
        "scripts/**"
      ],
      "blocked_globs": [
        ".git/**",
        ".github/**",
        "ai-memory/**"
      ],
      "conditional_blocked_globs": []
    }
  }
}
