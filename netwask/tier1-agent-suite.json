{
	"version": 1,
	"repo_key": "tele-funtoken-msg-scoring",
	"routing": {
		"telegram_only": true,
		"pr_inbox_topic": "PR Inbox",
		"allow_github_comments": false,
		"allow_github_issues": false
	},
	"config": {
		"branch_name": "ai/netwask/tier1-agent-suite",
		"pr": {
			"title": "chore: install Tier 1 agent suite workflows",
			"body": "## Summary\nInstall Tier 1 agent workflows and repo-level config generated by Netwask.\n\n## Included\n- CI Doctor\n- Workflow Health Manager\n- MCP Inspector\n- CI Coach\n- Observability Daily (Metrics Collector + Audit)\n- Portfolio Analyst\n\n## Notes\n- Alerts route to Telegram only\n- PR notifications are sent to PR Inbox"
		},
		"schedules": {
			"daily": "17 2 * * *",
			"weekly": "33 2 * * 1"
		},
		"agents": {
			"ci_doctor": {
				"enabled": true,
				"trigger": "workflow_run_failure"
			},
			"workflow_health_manager": {
				"enabled": true,
				"schedule": "daily"
			},
			"mcp_inspector": {
				"enabled": true,
				"schedule": "daily",
				"config_change_paths": [
					".github/workflows/**",
					".github/netwask/tier1-agent-suite.json",
					"netwask/config/tier1-agent-suite.json"
				]
			},
			"ci_coach": {
				"enabled": true,
				"schedule": "weekly"
			},
			"metrics_collector": {
				"enabled": true,
				"schedule": "daily"
			},
			"audit": {
				"enabled": true,
				"schedule": "daily"
			},
			"portfolio_analyst": {
				"enabled": true,
				"schedule": "weekly"
			}
		},
		"anti_spam": {
			"cooldown_seconds": 900,
			"window_seconds": 3600,
			"max_sends_per_window": 4,
			"dedupe_window_seconds": 7200
		}
	}
}
